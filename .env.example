# Official versioned images. Override only with an image compatible with sm_120.
VLLM_BASE_IMAGE=docker.io/vllm/vllm-openai:v0.32.0
SGLANG_BASE_IMAGE=docker.io/lmsysorg/sglang:v0.5.22

# Shared Hugging Face cache; paths are relative to the project.
# Linux users can replace this with /data/huggingface or ./.cache/huggingface.
HF_CACHE_DIR=./.cache/huggingface
HF_TOKEN=
LOCAL_MODELS_DIR=./models

# QuantTrio/Qwen3.5-9B-AWQ, downloaded and SHA-256 verified locally.
# Run one server at a time; start.cmd selects vLLM by default.
VLLM_MODEL=/models/Qwen3.5-9B-AWQ
SGLANG_MODEL=/models/Qwen3.5-9B-AWQ
SERVED_MODEL_NAME=Qwen3.5-9B-AWQ
MODEL_DTYPE=float16
SGLANG_MODEL_DTYPE=bfloat16
SGLANG_CONTEXT_LENGTH=32768
VLLM_GPU_MEMORY_UTILIZATION=0.60
SGLANG_MEM_FRACTION_STATIC=0.65
VLLM_CPU_OFFLOAD_GB=5
VLLM_CPU_OFFLOAD_PARAMS=mlp
SGLANG_CPU_OFFLOAD_GB=5
MAX_MODEL_LEN=16384
MAX_CONCURRENT_REQUESTS=1
VLLM_MAX_BATCHED_TOKENS=512
SGLANG_CHUNKED_PREFILL_SIZE=512
# This single-request profile needs 5 Mamba slots; reserve the rest for KV.
SGLANG_MAX_MAMBA_CACHE_SIZE=5
SGLANG_MAX_TOTAL_TOKENS=32768

# Bind only to this computer. Change the API key in your local .env file.
BIND_ADDRESS=127.0.0.1
VLLM_PORT=8000
SGLANG_PORT=30000
API_KEY=change-me-before-use
